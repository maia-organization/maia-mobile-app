{
  "name": "maia",
  "version": "1.0.0",
  "description": "Maia - Personalized training app based on menstrual cycle",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "backlog:plan": "node scripts/backlog/sync.mjs",
    "backlog:sync": "node scripts/backlog/sync.mjs --apply",
    "prepare": "husky",
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "npm --prefix backend install",
    "setup:frontend": "npm --prefix frontend install",
    "db:up": "docker-compose up -d postgres",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^8.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4"
  }
}

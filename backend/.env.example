NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://maia:maia@localhost:5432/maiadb
JWT_SECRET=replace-with-a-long-random-secret
# En production, remplacer par l'origine publique exacte, par exemple https://app.maia.fr
CORS_ORIGIN=http://localhost:8081
# URL de deep link Maïa utilisée dans l'e-mail de réinitialisation.
PASSWORD_RESET_URL=maia://reset-password
# Configuration Resend (ne jamais versionner les valeurs réelles).
RESEND_API_KEY=
RESET_EMAIL_FROM=Maïa <no-reply@example.com>

{
  "name": "maia-backend",
  "version": "1.0.0",
  "description": "Backend API for Maia app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:integration": "node scripts/smoke-auth.js",
    "db:generate": "XDG_DATA_HOME=.cache drizzle-kit generate",
    "db:migrate": "XDG_DATA_HOME=.cache drizzle-kit migrate",
    "db:upgrade": "XDG_DATA_HOME=.cache drizzle-kit up",
    "db:studio": "XDG_DATA_HOME=.cache drizzle-kit studio",
    "notifications:send-workout-reminders": "node scripts/send-workout-reminders.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.8.7",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
